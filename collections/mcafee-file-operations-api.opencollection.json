{
  "opencollection": "1.0.0",
  "info": {
    "name": "McAfee ePO Alarms File Operations API",
    "version": "5.10"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "File Operations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "McAfee Export configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{epo-server}:8443/remote/file/export"
          },
          "docs": "Export the complete appliance configuration as a backup file."
        },
        {
          "info": {
            "name": "McAfee Import configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{epo-server}:8443/remote/file/import",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Import a previously exported configuration backup to restore settings."
        }
      ]
    }
  ],
  "bundled": true
}