{
  "opencollection": "1.0.0",
  "info": {
    "name": "McAfee ePO Alarms Data Sources API",
    "version": "5.10"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "McAfee List data sources",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{epo-server}:8443/remote/v2/dsGetDataSourceList"
          },
          "docs": "Retrieve all configured data sources that feed events into the ESM, including syslog sources, database connections, and agent-based sources."
        }
      ]
    }
  ],
  "bundled": true
}